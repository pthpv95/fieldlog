{
  "name": "fieldlog",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first orchard inspection app - portfolio project by Hien Pham",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @fieldlog/api dev",
    "dev:web": "pnpm --filter @fieldlog/web dev",
    "dev:mobile": "pnpm --filter @fieldlog/mobile start",
    "db:migrate": "pnpm --filter @fieldlog/db migrate",
    "db:seed": "pnpm --filter @fieldlog/db seed",
    "db:studio": "pnpm --filter @fieldlog/db studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
